#!/usr/bin/env node
// Claude Code hook -> operator bridge.
// Every failure path exits 0 with no output, which tells Claude Code to carry on
// exactly as if this hook didn't exist (for permissions: show its normal prompt).
// It never approves anything on its own; only an explicit click in operator does.

const BASE = process.env.OPERATOR_URL ?? "http://127.0.0.1:4477";
// Approvals and questions also show in the terminal while we wait, so waiting long costs
// nothing: the deck stays answerable until it's answered somewhere. Keep it under the hook's
// "timeout" in settings.json, or Claude Code kills us first.
const TIMEOUT_MS = Number(process.env.OPERATOR_TIMEOUT_MS ?? 3600000);
// Set by `sop operator`, so the server knows which session is the operator.
const ROLE = process.env.OPERATOR_ROLE ?? null;

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
}

async function post(path, body, ms) {
  const res = await fetch(BASE + path, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(ms),
  });
  if (!res.ok) throw new Error(`status ${res.status}`);
  return res.json();
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// Waits out a server restart instead of giving up: while it's down we retry, and once a new
// server is up (a different boot id) we register again, keeping the original start time so
// an answer given in the terminal meanwhile still clears the card.
async function waitForDecision(payload, deadline) {
  const createdAt = new Date().toISOString();
  const register = () =>
    post("/api/hook", { ...payload, operator_role: ROLE, operator_timeout_ms: deadline - Date.now(), operator_created_at: createdAt }, 2000);
  let reg = await register();
  if (!reg.id) return null;
  while (Date.now() < deadline) {
    let body;
    try {
      const res = await fetch(`${BASE}/api/decisions/${reg.id}/wait`, { signal: AbortSignal.timeout(30000) });
      body = await res.json();
    } catch {
      await sleep(1000);
      continue;
    }
    if (body.status === "decided") return body;
    if (body.status === "pending") continue;
    // Gone from this server: answered elsewhere or dropped. Gone because it's a new server: re-register.
    if (!body.boot || body.boot === reg.boot) return null;
    try {
      reg = await register();
      if (!reg.id) return null;
    } catch {
      await sleep(1000);
    }
  }
  return null;
}

async function main() {
  const payload = await readStdin();
  if (payload.hook_event_name !== "PermissionRequest") {
    await post("/api/hook", { ...payload, operator_role: ROLE }, 1500);
    return;
  }
  const decision = await waitForDecision(payload, Date.now() + TIMEOUT_MS);
  if (!decision || (decision.behavior !== "allow" && decision.behavior !== "deny")) return;
  const out = { behavior: decision.behavior };
  if (decision.behavior === "deny") out.message = decision.message || "Denied from operator";
  if (decision.behavior === "allow" && decision.updatedInput) out.updatedInput = decision.updatedInput;
  // "Yes, and don't ask again": one of Claude Code's own permission_suggestions, sent back.
  if (decision.behavior === "allow" && decision.updatedPermissions) out.updatedPermissions = decision.updatedPermissions;
  process.stdout.write(
    JSON.stringify({
      hookSpecificOutput: { hookEventName: "PermissionRequest", decision: out },
    }),
  );
}

main()
  .catch(() => {})
  .finally(() => process.exit(0));
