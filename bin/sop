#!/usr/bin/env node
// sop (session operator): starts the operator, and is the operator's console for listing,
// reading, messaging, starting and ending Claude Code sessions through the server.

import { execFileSync, spawnSync } from "node:child_process";
import { copyFileSync, existsSync, lstatSync, mkdirSync, readFileSync, readlinkSync, symlinkSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const BASE = process.env.OPERATOR_URL ?? "http://127.0.0.1:4477";

const USAGE = `sop - session operator

  sop setup [--dry-run]           install the hooks in ~/.claude/settings.json and sop in ~/.local/bin
  sop operator [claude args...]   resume the operator session in this terminal (--new for a fresh one)

  sop ls                          every session: who, status, what it needs
  sop feed <who> [n]              a session's last n messages (default 12)
  sop say <who> <text...>         type a message into a session and press Enter
  sop end <who>                   /exit a session and close its iTerm tab or tmux pane
  sop start <dir> [options] <prompt...>
      --worktree <branch>          make a git worktree for <branch> off --base first
      --base <ref>                 base for the new branch (default origin/main)
      --badge <label>              iTerm badge for the new tab, or tmux window name
      --term iterm|tmux            where to start it (default $OPERATOR_TERMINAL, else iterm)

<who> is a session id prefix, a card or issue like sc-8121 or 123, a project name, or part of a branch.`;

function die(msg) {
  console.error(msg);
  process.exit(1);
}

async function api(path, init) {
  let res;
  try {
    res = await fetch(BASE + path, init);
  } catch {
    die(`session operator server isn't running at ${BASE}`);
  }
  const body = res.headers.get("content-type")?.includes("json") ? await res.json() : await res.text();
  if (!res.ok) die(typeof body === "object" && body?.error ? body.error : `${path}: ${res.status}`);
  return body;
}

const post = (path, body) =>
  api(path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });

function label(s) {
  const card = s.refs.find((r) => r.source === "own" && r.kind === "card") ?? s.refs.find((r) => r.source === "own" && r.kind === "issue");
  if (card) return card.label;
  return s.branch && s.branch !== "main" ? `${s.project} (${s.branch})` : s.project;
}

function need(s) {
  if (s.status === "blocked") return `waiting on ${s.blockedOn}`;
  if (s.status === "done") return s.nextAction ?? "finished its turn";
  return s.statusDetail;
}

async function find(who) {
  const { sessions } = await api("/api/state");
  const w = who.toLowerCase();
  const matches = sessions.filter(
    (s) =>
      s.id.startsWith(w) ||
      (w === "operator" && s.role === "operator") ||
      label(s).toLowerCase() === w ||
      s.refs.some((r) => r.source === "own" && (r.label.toLowerCase() === w || r.label.toLowerCase().endsWith(`#${w.replace(/^#/, "")}`))) ||
      s.project.toLowerCase() === w ||
      (s.branch ?? "").toLowerCase().includes(w),
  );
  // Prefer running sessions when an old closed one matches too.
  const live = matches.filter((s) => s.live);
  const pick = live.length > 0 ? live : matches;
  if (pick.length === 0) die(`no session matches "${who}" - try sop ls`);
  if (pick.length > 1) die(`"${who}" matches ${pick.length} sessions:\n${pick.map((s) => `  ${s.id.slice(0, 8)}  ${label(s)}`).join("\n")}`);
  return pick[0];
}

async function ls() {
  const { sessions, pending } = await api("/api/state");
  for (const s of sessions) {
    const role = s.role === "operator" ? " (operator)" : "";
    console.log(`${s.id.slice(0, 8)}  ${s.status.padEnd(8)}  ${label(s)}${role}${s.live ? "" : " [not running]"}\n          ${need(s)}`);
  }
  for (const p of pending) console.log(`approval  ${p.sessionId.slice(0, 8)} wants ${p.toolName}: ${p.summary}`);
}

async function feed(who, n = "12") {
  const s = await find(who);
  const items = await api(`/api/sessions/${s.id}/feed`);
  for (const f of items.slice(-Number(n))) {
    // Tool lines get trimmed; messages print in full (the server already trims the middle of long ones).
    const text = f.kind === "tool" && f.text.length > 300 ? `${f.text.slice(0, 300)}...` : f.text;
    console.log(`[${f.kind}] ${text}\n`);
  }
}

async function say(who, words) {
  if (words.length === 0) die("sop say <who> <text>");
  const s = await find(who);
  await post(`/api/sessions/${s.id}/reply`, { text: words.join(" ") });
  console.log(`sent to ${label(s)}`);
}

async function end(who) {
  const s = await find(who);
  await post(`/api/sessions/${s.id}/close`, {});
  console.log(`ended ${label(s)}`);
}

function start(args) {
  const opts = { base: "origin/main" };
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--worktree" || a === "--base" || a === "--badge" || a === "--term") opts[a.slice(2)] = args[++i];
    else rest.push(a);
  }
  const [dirArg, ...promptWords] = rest;
  if (!dirArg || promptWords.length === 0) die("sop start <dir> [--worktree <branch>] [--badge <label>] [--term iterm|tmux] <prompt>");
  const term = opts.term ?? process.env.OPERATOR_TERMINAL ?? "iterm";
  if (term !== "tmux" && term !== "iterm") die(`--term is iterm or tmux, not "${term}"`);
  let dir = resolve(dirArg);
  if (!existsSync(dir)) die(`${dir} doesn't exist`);
  if (opts.worktree) {
    // Flat dir names under .worktrees: sc-8121/foo-bar -> sc-8121-foo-bar.
    const name = opts.worktree.replace(/\//g, "-").slice(0, 60);
    const wt = join(dir, ".worktrees", name);
    if (existsSync(wt)) die(`${wt} already exists`);
    execFileSync("git", ["-C", dir, "fetch", "-q", "origin"], { stdio: "inherit" });
    execFileSync("git", ["-C", dir, "worktree", "add", "-q", wt, "-b", opts.worktree, opts.base], { stdio: "inherit" });
    dir = wt;
  }
  const badge = opts.badge ?? (opts.worktree ? opts.worktree.split("/")[0] : basename(dir));
  const prompt = promptWords.join(" ");
  if (term === "tmux") startInTmux(dir, badge, prompt);
  else startInIterm(dir, badge, prompt);
  console.log(`started a session in ${dir} (${term === "tmux" ? "tmux window" : "badge"} "${badge}")`);
}

// A new window in this tmux session, or in a detached "sop" session when sop isn't running
// inside tmux (tmux attach -t sop to see them). claude runs as the window's command, as argv,
// so the window closes when it exits.
function startInTmux(dir, name, prompt) {
  const window = ["-n", name, "-c", dir, "--", "claude", prompt];
  if (process.env.TMUX) return execFileSync("tmux", ["new-window", "-d", ...window]);
  // The first one makes the session, so there's no stray shell window in it.
  if (spawnSync("tmux", ["has-session", "-t", "=sop"], { stdio: "ignore" }).status !== 0) {
    return execFileSync("tmux", ["new-session", "-d", "-s", "sop", ...window]);
  }
  execFileSync("tmux", ["new-window", "-d", "-t", "=sop:", ...window]);
}

function startInIterm(dir, badge, prompt) {
  // Values go in as argv and through `quoted form of`, never spliced into script source.
  const script = `
on run argv
  set cmd to "cd " & quoted form of (item 1 of argv) & " && (command -v badge >/dev/null && badge " & quoted form of (item 2 of argv) & "; true) && claude " & quoted form of (item 3 of argv)
  tell application "iTerm2"
    tell current window
      set t to (create tab with default profile)
      tell current session of t to write text cmd
    end tell
  end tell
end run`;
  execFileSync("osascript", ["-e", script, dir, badge, prompt]);
}

// The operator's tab badge is fixed so it's easy to spot. Uses the `badge` script if it's on
// PATH, else writes OSC 1337 SetBadgeFormat to the terminal. Not iTerm, no tty: nothing happens.
function setBadge(text) {
  if (spawnSync("badge", [text], { stdio: "ignore" }).status === 0) return;
  try {
    writeFileSync("/dev/tty", `\x1b]1337;SetBadgeFormat=${Buffer.from(text).toString("base64")}\x07`);
  } catch {}
}

// The operator is a Claude session with docs/operator-prompt.md appended to its system
// prompt. OPERATOR_ROLE tells the hook, and so the server, which session it is. It's always
// the same session: the server remembers the last one, and this resumes it.
async function operator(args) {
  const fresh = args.includes("--new");
  args = args.filter((a) => a !== "--new");
  let last = null;
  try {
    last = JSON.parse(readFileSync(join(tmpdir(), "session-operator-roles.json"), "utf8")).at(-1) ?? null;
  } catch {}
  // One operator at a time, --new included: the server only tracks the newest.
  if (last) {
    const running = await fetch(`${BASE}/api/state`)
      .then((r) => r.json())
      .then((d) => d.sessions.some((s) => s.id === last && s.live))
      .catch(() => false);
    if (running) die(`the operator (${last.slice(0, 8)}) is already running in another tab`);
  }
  if (last && !fresh && !args.some((a) => a.startsWith("--resume") || a === "-r" || a === "--continue" || a === "-c")) {
    args = ["--resume", last, ...args];
  }
  const here = dirname(fileURLToPath(import.meta.url));
  const prompt = readFileSync(join(here, "..", "docs", "operator-prompt.md"), "utf8");
  setBadge("session operator");
  const r = spawnSync("claude", ["--append-system-prompt", prompt, ...args], {
    stdio: "inherit",
    env: { ...process.env, OPERATOR_ROLE: "operator" },
  });
  process.exit(r.status ?? 1);
}

// The hooks the deck needs. PermissionRequest waits for your answer for up to an hour, so its
// timeout sits just above the hook's own (OPERATOR_TIMEOUT_MS plus one poll).
const HOOK_EVENTS = { PermissionRequest: 3660, Notification: 5, Stop: 5, UserPromptSubmit: 5, SessionEnd: 5 };

// Merges the hooks into ~/.claude/settings.json next to whatever's already there, pointing at
// the main checkout (never a worktree, which goes away when its branch is done). An old
// operator-hook path is updated in place, never duplicated. Then links sop into ~/.local/bin.
// Safe to run again.
function setup(args) {
  const dry = args.includes("--dry-run");
  const here = resolve(dirname(fileURLToPath(import.meta.url)), "..");
  let repo = here;
  try {
    repo = dirname(execFileSync("git", ["-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"], { encoding: "utf8" }).trim());
  } catch {}
  if (repo !== here) console.log(`this is a worktree, so the hooks point at the main checkout: ${repo}`);
  const hookPath = join(repo, "bin", "operator-hook");
  if (!existsSync(hookPath)) die(`${hookPath} isn't there - update the main checkout first`);
  // Claude Code runs the command through a shell, so a path with spaces needs quotes.
  const hook = /^[\w./-]+$/.test(hookPath) ? hookPath : `'${hookPath.replaceAll("'", `'\\''`)}'`;
  const settingsPath = join(homedir(), ".claude", "settings.json");
  const changes = [];

  let settings = {};
  if (existsSync(settingsPath)) {
    try {
      settings = JSON.parse(readFileSync(settingsPath, "utf8"));
    } catch {
      die(`${settingsPath} isn't valid JSON - fix it first, setup won't overwrite it`);
    }
  }
  settings.hooks ??= {};
  for (const [event, timeout] of Object.entries(HOOK_EVENTS)) {
    const groups = (settings.hooks[event] ??= []);
    const ours = groups.flatMap((g) => g.hooks ?? []).find((h) => typeof h.command === "string" && h.command.includes("operator-hook"));
    if (!ours) {
      groups.push({ hooks: [{ type: "command", command: hook, timeout }] });
      changes.push(`add ${event} hook`);
    } else if (ours.command.replace(/^\$HOME|^~/, homedir()) !== hook || ours.timeout !== timeout) {
      changes.push(`update ${event} hook (${ours.command}, ${ours.timeout ?? "no"} timeout -> ${hook}, ${timeout})`);
      ours.command = hook;
      ours.timeout = timeout;
    }
  }
  let backup = null;
  if (changes.length > 0 && !dry) {
    mkdirSync(dirname(settingsPath), { recursive: true });
    if (existsSync(settingsPath)) copyFileSync(settingsPath, (backup = `${settingsPath}.bak-${Date.now()}`));
    writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`);
  }

  const bin = join(homedir(), ".local", "bin");
  const link = join(bin, "sop");
  const target = join(repo, "bin", "sop");
  let current = null;
  try {
    current = lstatSync(link).isSymbolicLink() ? readlinkSync(link) : "a file";
  } catch {}
  if (current === "a file") {
    console.log(`left ${link} alone: it's a real file, not a link`);
  } else if (current !== target) {
    changes.push(`link ${link} -> ${target}`);
    if (!dry) {
      mkdirSync(bin, { recursive: true });
      if (current) unlinkSync(link);
      symlinkSync(target, link);
    }
  }

  console.log(changes.length === 0 ? "already set up" : `${dry ? "would " : ""}${changes.join("\n" + (dry ? "would " : ""))}`);
  if (backup) console.log(`(old settings backed up to ${backup})`);
  console.log(`
then:
  cd ${repo} && pnpm install && pnpm build && pnpm start     the deck, at ${BASE}
  gh auth refresh -s read:project                              GitHub Project status on issues
  export OPERATOR_TERMINAL=tmux                                 if sop start should use tmux
  export SHORTCUT_API_TOKEN=...                                 only if you use Shortcut
Sessions already open pick up the hooks once they're restarted.`);
}

const [cmd, ...args] = process.argv.slice(2);
const commands = {
  operator: () => operator(args),
  ls: () => ls(),
  feed: () => (args[0] ? feed(args[0], args[1]) : die("sop feed <who> [n]")),
  say: () => (args[0] ? say(args[0], args.slice(1)) : die("sop say <who> <text>")),
  end: () => (args[0] ? end(args[0]) : die("sop end <who>")),
  start: () => start(args),
  setup: () => setup(args),
};
if (!commands[cmd]) {
  console.log(USAGE);
  process.exit(cmd ? 1 : 0);
}
await commands[cmd]();
